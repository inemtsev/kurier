# Copy this file to `.env` (gitignored) and fill in whichever bot token(s) you have.
# The echo-bot sample loads `.env` automatically and installs an adapter per token present:
#   ./gradlew :samples:echo-bot:run
# With no token it falls back to an in-memory console echo.
TG_TOKEN=
# Discord: needs the privileged "Message Content" intent enabled in the dev portal.
DISCORD_TOKEN=
# Matrix: the bot's homeserver URL plus an access token (both required). Unencrypted rooms only.
MATRIX_HOMESERVER=
MATRIX_TOKEN=
# Twitch: app client id + user OAuth token (user:read:chat + user:write:chat scopes) + the
# broadcaster login whose chat to join — all three required. Secret + refresh token are optional;
# with both set, an expired access token refreshes itself.
TWITCH_CLIENT_ID=
TWITCH_TOKEN=
TWITCH_CHANNEL=
TWITCH_CLIENT_SECRET=
TWITCH_REFRESH_TOKEN=
# Slack: bot token (xoxb-…) + Socket Mode app-level token (xapp-…), both required.
# App setup (Socket Mode, scopes, event subscriptions): docs/slack-setup.md
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
